    <worksheet name="Funnel">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#0b0b0b" fontsize="11">Share of sign-ups reaching each stage, by platform (Android drops at the photo step)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Funnel stages" name="federated.funnel" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="federated.funnel">
            <column caption="In scope" datatype="boolean" name="[In scope]" role="dimension" type="nominal">
              <calculation class="tableau" formula="([Parameters].[Country] = &quot;All&quot; OR [country] = [Parameters].[Country]) AND ([Parameters].[Platform] = &quot;All&quot; OR [platform] = [Parameters].[Platform])" />
            </column>
            <column caption="Share of sign-ups" datatype="real" default-format="p0%" name="[Share of sign-ups]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([users]) / SUM([Sign-ups (EXCLUDE stage)])" />
            </column>
            <column caption="Sign-ups (EXCLUDE stage)" datatype="real" name="[Sign-ups (EXCLUDE stage)]" role="measure" type="quantitative">
              <calculation class="tableau" formula="{EXCLUDE [stage], [stage_order] : SUM(IF [stage_order] = 1 THEN [users] END)}" />
            </column>
            <column datatype="string" name="[country]" role="dimension" type="nominal" />
            <column caption="Platform" datatype="string" name="[platform]" role="dimension" type="nominal" />
            <column caption="Stage" datatype="string" name="[stage]" role="dimension" type="nominal" />
            <column datatype="integer" name="[stage_order]" role="dimension" type="ordinal" />
            <column caption="Users" datatype="integer" name="[users]" role="measure" type="quantitative" />
            <column-instance column="[In scope]" derivation="None" name="[none:In scope:nk]" pivot="key" type="nominal" />
            <column-instance column="[platform]" derivation="None" name="[none:platform:nk]" pivot="key" type="nominal" />
            <column-instance column="[stage]" derivation="None" name="[none:stage:nk]" pivot="key" type="nominal" />
            <column-instance column="[stage_order]" derivation="None" name="[none:stage_order:ok]" pivot="key" type="ordinal" />
            <column-instance column="[Share of sign-ups]" derivation="User" name="[usr:Share of sign-ups:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Country" datatype="string" name="[Country]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
              <calculation class="tableau" formula="&quot;All&quot;" />
              <members>
                <member value="&quot;All&quot;" />
                <member value="&quot;US&quot;" />
                <member value="&quot;GB&quot;" />
                <member value="&quot;CA&quot;" />
                <member value="&quot;AU&quot;" />
              </members>
            </column>
            <column caption="Platform" datatype="string" name="[Platform]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
              <calculation class="tableau" formula="&quot;All&quot;" />
              <members>
                <member value="&quot;All&quot;" />
                <member value="&quot;ios&quot;" />
                <member value="&quot;android&quot;" />
              </members>
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[federated.funnel].[none:In scope:nk]">
            <groupfilter function="member" level="[none:In scope:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <slices>
            <column>[federated.funnel].[none:In scope:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[federated.funnel].[none:platform:nk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([federated.funnel].[none:stage_order:ok] / [federated.funnel].[none:stage:nk] / [federated.funnel].[none:platform:nk])</rows>
        <cols>[federated.funnel].[usr:Share of sign-ups:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Retention curves">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#0b0b0b" fontsize="11">Share of each monthly cohort active N days after sign-up</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Retention by cohort" name="federated.retention" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="federated.retention">
            <column caption="Cohort" datatype="string" name="[Cohort]" role="dimension" type="nominal">
              <calculation class="tableau" formula="STR(YEAR([cohort_month])) + &quot;-&quot; + RIGHT(&quot;0&quot; + STR(MONTH([cohort_month])), 2)" />
            </column>
            <column caption="Curve window" datatype="boolean" name="[Curve window]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[fully_observed] AND [day_since_signup] &gt;= 1 AND [day_since_signup] &lt;= 30" />
            </column>
            <column caption="In scope" datatype="boolean" name="[In scope]" role="dimension" type="nominal">
              <calculation class="tableau" formula="([Parameters].[Country] = &quot;All&quot; OR [country] = [Parameters].[Country]) AND ([Parameters].[Platform] = &quot;All&quot; OR [platform] = [Parameters].[Platform])" />
            </column>
            <column caption="Retention" datatype="real" default-format="p0.0%" name="[Retention]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([active_users]) / SUM([cohort_size])" />
            </column>
            <column datatype="integer" name="[active_users]" role="measure" type="quantitative" />
            <column caption="Cohort month" datatype="date" name="[cohort_month]" role="dimension" type="ordinal" />
            <column datatype="integer" name="[cohort_size]" role="measure" type="quantitative" />
            <column datatype="string" name="[country]" role="dimension" type="nominal" />
            <column caption="Days since sign-up" datatype="integer" name="[day_since_signup]" role="dimension" type="ordinal" />
            <column datatype="boolean" name="[fully_observed]" role="dimension" type="nominal" />
            <column datatype="string" name="[platform]" role="dimension" type="nominal" />
            <column-instance column="[Cohort]" derivation="None" name="[none:Cohort:nk]" pivot="key" type="nominal" />
            <column-instance column="[Curve window]" derivation="None" name="[none:Curve window:nk]" pivot="key" type="nominal" />
            <column-instance column="[In scope]" derivation="None" name="[none:In scope:nk]" pivot="key" type="nominal" />
            <column-instance column="[day_since_signup]" derivation="None" name="[none:day_since_signup:ok]" pivot="key" type="ordinal" />
            <column-instance column="[Retention]" derivation="User" name="[usr:Retention:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Country" datatype="string" name="[Country]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
              <calculation class="tableau" formula="&quot;All&quot;" />
              <members>
                <member value="&quot;All&quot;" />
                <member value="&quot;US&quot;" />
                <member value="&quot;GB&quot;" />
                <member value="&quot;CA&quot;" />
                <member value="&quot;AU&quot;" />
              </members>
            </column>
            <column caption="Platform" datatype="string" name="[Platform]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
              <calculation class="tableau" formula="&quot;All&quot;" />
              <members>
                <member value="&quot;All&quot;" />
                <member value="&quot;ios&quot;" />
                <member value="&quot;android&quot;" />
              </members>
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[federated.retention].[none:In scope:nk]">
            <groupfilter function="member" level="[none:In scope:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[federated.retention].[none:Curve window:nk]">
            <groupfilter function="member" level="[none:Curve window:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <slices>
            <column>[federated.retention].[none:In scope:nk]</column>
            <column>[federated.retention].[none:Curve window:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="axis">
            <format attr="title" class="0" field="[federated.retention].[none:day_since_signup:ok]" scope="cols" value="days since sign-up" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <color column="[federated.retention].[none:Cohort:nk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.retention].[usr:Retention:qk]</rows>
        <cols>[federated.retention].[none:day_since_signup:ok]</cols>
      </table>
    </worksheet>
    <worksheet name="Day-7 by channel">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#0b0b0b" fontsize="11">Day-7 retention by acquisition channel</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Retention by cohort" name="federated.retention" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="federated.retention">
            <column caption="Day-7 observable" datatype="boolean" name="[Day-7 observable]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[cohort_month] &lt;= #2026-09-01#" />
            </column>
            <column caption="Day-7 retention" datatype="real" default-format="p0.0%" name="[Day-7 retention]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IF [day_since_signup] = 7 THEN [active_users] END) / SUM(IF [day_since_signup] = 7 THEN [cohort_size] END)" />
            </column>
            <column caption="In scope" datatype="boolean" name="[In scope]" role="dimension" type="nominal">
              <calculation class="tableau" formula="([Parameters].[Country] = &quot;All&quot; OR [country] = [Parameters].[Country]) AND ([Parameters].[Platform] = &quot;All&quot; OR [platform] = [Parameters].[Platform])" />
            </column>
            <column datatype="integer" name="[active_users]" role="measure" type="quantitative" />
            <column caption="Channel" datatype="string" name="[channel]" role="dimension" type="nominal" />
            <column caption="Cohort month" datatype="date" name="[cohort_month]" role="dimension" type="ordinal" />
            <column datatype="integer" name="[cohort_size]" role="measure" type="quantitative" />
            <column datatype="string" name="[country]" role="dimension" type="nominal" />
            <column caption="Days since sign-up" datatype="integer" name="[day_since_signup]" role="dimension" type="ordinal" />
            <column datatype="string" name="[platform]" role="dimension" type="nominal" />
            <column-instance column="[Day-7 observable]" derivation="None" name="[none:Day-7 observable:nk]" pivot="key" type="nominal" />
            <column-instance column="[In scope]" derivation="None" name="[none:In scope:nk]" pivot="key" type="nominal" />
            <column-instance column="[channel]" derivation="None" name="[none:channel:nk]" pivot="key" type="nominal" />
            <column-instance column="[Day-7 retention]" derivation="User" name="[usr:Day-7 retention:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Country" datatype="string" name="[Country]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
              <calculation class="tableau" formula="&quot;All&quot;" />
              <members>
                <member value="&quot;All&quot;" />
                <member value="&quot;US&quot;" />
                <member value="&quot;GB&quot;" />
                <member value="&quot;CA&quot;" />
                <member value="&quot;AU&quot;" />
              </members>
            </column>
            <column caption="Platform" datatype="string" name="[Platform]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
              <calculation class="tableau" formula="&quot;All&quot;" />
              <members>
                <member value="&quot;All&quot;" />
                <member value="&quot;ios&quot;" />
                <member value="&quot;android&quot;" />
              </members>
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[federated.retention].[none:In scope:nk]">
            <groupfilter function="member" level="[none:In scope:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[federated.retention].[none:Day-7 observable:nk]">
            <groupfilter function="member" level="[none:Day-7 observable:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <sort class="computed" column="[federated.retention].[none:channel:nk]" direction="DESC" using="[federated.retention].[usr:Day-7 retention:qk]" />
          <slices>
            <column>[federated.retention].[none:In scope:nk]</column>
            <column>[federated.retention].[none:Day-7 observable:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
                <format attr="mark-color" value="#2a78d6" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.retention].[none:channel:nk]</rows>
        <cols>[federated.retention].[usr:Day-7 retention:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Paid share by channel">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#0b0b0b" fontsize="11">Share of sign-ups who ever paid, by channel</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Funnel stages" name="federated.funnel" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="federated.funnel">
            <column caption="In scope" datatype="boolean" name="[In scope]" role="dimension" type="nominal">
              <calculation class="tableau" formula="([Parameters].[Country] = &quot;All&quot; OR [country] = [Parameters].[Country]) AND ([Parameters].[Platform] = &quot;All&quot; OR [platform] = [Parameters].[Platform])" />
            </column>
            <column caption="Paid share" datatype="real" default-format="p0.0%" name="[Paid share]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IF [stage_order] = 11 THEN [users] END) / SUM(IF [stage_order] = 1 THEN [users] END)" />
            </column>
            <column caption="Channel" datatype="string" name="[channel]" role="dimension" type="nominal" />
            <column datatype="string" name="[country]" role="dimension" type="nominal" />
            <column caption="Platform" datatype="string" name="[platform]" role="dimension" type="nominal" />
            <column datatype="integer" name="[stage_order]" role="dimension" type="ordinal" />
            <column caption="Users" datatype="integer" name="[users]" role="measure" type="quantitative" />
            <column-instance column="[In scope]" derivation="None" name="[none:In scope:nk]" pivot="key" type="nominal" />
            <column-instance column="[channel]" derivation="None" name="[none:channel:nk]" pivot="key" type="nominal" />
            <column-instance column="[Paid share]" derivation="User" name="[usr:Paid share:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Country" datatype="string" name="[Country]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
              <calculation class="tableau" formula="&quot;All&quot;" />
              <members>
                <member value="&quot;All&quot;" />
                <member value="&quot;US&quot;" />
                <member value="&quot;GB&quot;" />
                <member value="&quot;CA&quot;" />
                <member value="&quot;AU&quot;" />
              </members>
            </column>
            <column caption="Platform" datatype="string" name="[Platform]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
              <calculation class="tableau" formula="&quot;All&quot;" />
              <members>
                <member value="&quot;All&quot;" />
                <member value="&quot;ios&quot;" />
                <member value="&quot;android&quot;" />
              </members>
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[federated.funnel].[none:In scope:nk]">
            <groupfilter function="member" level="[none:In scope:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <sort class="computed" column="[federated.funnel].[none:channel:nk]" direction="DESC" using="[federated.funnel].[usr:Paid share:qk]" />
          <slices>
            <column>[federated.funnel].[none:In scope:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
                <format attr="mark-color" value="#104281" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.funnel].[none:channel:nk]</rows>
        <cols>[federated.funnel].[usr:Paid share:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Forest">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#0b0b0b" fontsize="11">Relative effect, 95% confidence interval (bar = interval)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Experiment read-outs" name="federated.experiments" />
          </datasources>
          <datasource-dependencies datasource="federated.experiments">
            <column caption="CI width" datatype="real" default-format="p0.0%" name="[CI width]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM([ci_high]) - SUM([ci_low])" />
            </column>
            <column caption="Effect txt" datatype="string" name="[Effect txt]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(SUM([estimate]) * 100, 1)) + &quot;%  [&quot; + STR(ROUND(SUM([ci_low]) * 100, 1)) + &quot;, &quot; + STR(ROUND(SUM([ci_high]) * 100, 1)) + &quot;]&quot;" />
            </column>
            <column caption="Test" datatype="string" name="[Test]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[experiment] + &quot;  ·  &quot; + [read]" />
            </column>
            <column caption="Verdict" datatype="string" name="[Verdict]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF CONTAINS([read], &quot;biased&quot;) OR CONTAINS([read], &quot;SRM&quot;) OR CONTAINS([read], &quot;misleading&quot;) THEN &quot;Misleading read&quot; ELSEIF [ci_low] &gt; 0 OR [ci_high] &lt; 0 THEN &quot;Effect (CI excludes 0)&quot; ELSE &quot;No clear effect&quot; END" />
            </column>
            <column datatype="real" name="[ci_high]" role="measure" type="quantitative" />
            <column datatype="real" name="[ci_low]" role="measure" type="quantitative" />
            <column datatype="real" name="[estimate]" role="measure" type="quantitative" />
            <column caption="Experiment" datatype="string" name="[experiment]" role="dimension" type="nominal" />
            <column caption="Read" datatype="string" name="[read]" role="dimension" type="nominal" />
            <column-instance column="[Test]" derivation="None" name="[none:Test:nk]" pivot="key" type="nominal" />
            <column-instance column="[Verdict]" derivation="None" name="[none:Verdict:nk]" pivot="key" type="nominal" />
            <column-instance column="[ci_low]" derivation="Sum" name="[sum:ci_low:qk]" pivot="key" type="quantitative" />
            <column-instance column="[CI width]" derivation="User" name="[usr:CI width:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Effect txt]" derivation="User" name="[usr:Effect txt:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="axis">
            <format attr="title" class="0" field="[federated.experiments].[sum:ci_low:qk]" scope="cols" value="relative effect" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="GanttBar" />
            <encodings>
              <color column="[federated.experiments].[none:Verdict:nk]" />
              <size column="[federated.experiments].[usr:CI width:qk]" />
              <text column="[federated.experiments].[usr:Effect txt:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor="#0b0b0b" fontsize="8">&lt;[federated.experiments].[usr:Effect txt:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.experiments].[none:Test:nk]</rows>
        <cols>[federated.experiments].[sum:ci_low:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Read-out table">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#0b0b0b" fontsize="11">Read-outs, SRM check and decision</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Experiment read-outs" name="federated.experiments" />
          </datasources>
          <datasource-dependencies datasource="federated.experiments">
            <column caption="Effect txt" datatype="string" name="[Effect txt]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(SUM([estimate]) * 100, 1)) + &quot;%  [&quot; + STR(ROUND(SUM([ci_low]) * 100, 1)) + &quot;, &quot; + STR(ROUND(SUM([ci_high]) * 100, 1)) + &quot;]&quot;" />
            </column>
            <column caption="SRM txt" datatype="string" name="[SRM txt]" role="measure" type="nominal">
              <calculation class="tableau" formula="IF ISNULL(SUM([srm_p])) THEN &quot;&quot; ELSEIF SUM([srm_p]) &lt; 0.001 THEN &quot;SRM! p &lt; 0.001&quot; ELSE &quot;SRM ok&quot; END" />
            </column>
            <column datatype="real" name="[ci_high]" role="measure" type="quantitative" />
            <column datatype="string" name="[decision]" role="dimension" type="nominal" />
            <column datatype="real" name="[estimate]" role="measure" type="quantitative" />
            <column caption="Experiment" datatype="string" name="[experiment]" role="dimension" type="nominal" />
            <column caption="p txt" datatype="string" name="[p txt]" role="measure" type="nominal">
              <calculation class="tableau" formula="IF ISNULL(SUM([p_value])) THEN &quot;&quot; ELSEIF SUM([p_value]) &lt; 0.001 THEN &quot;p &lt; 0.001&quot; ELSE &quot;p = &quot; + STR(ROUND(SUM([p_value]), 3)) END" />
            </column>
            <column datatype="real" name="[p_value]" role="measure" type="quantitative" />
            <column caption="Read" datatype="string" name="[read]" role="dimension" type="nominal" />
            <column datatype="real" name="[srm_p]" role="measure" type="quantitative" />
            <column-instance column="[decision]" derivation="None" name="[none:decision:nk]" pivot="key" type="nominal" />
            <column-instance column="[experiment]" derivation="None" name="[none:experiment:nk]" pivot="key" type="nominal" />
            <column-instance column="[read]" derivation="None" name="[none:read:nk]" pivot="key" type="nominal" />
            <column-instance column="[Effect txt]" derivation="User" name="[usr:Effect txt:nk]" pivot="key" type="nominal" />
            <column-instance column="[SRM txt]" derivation="User" name="[usr:SRM txt:nk]" pivot="key" type="nominal" />
            <column-instance column="[p txt]" derivation="User" name="[usr:p txt:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[federated.experiments].[usr:Effect txt:nk]" />
              <text column="[federated.experiments].[usr:p txt:nk]" />
              <text column="[federated.experiments].[usr:SRM txt:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor="#0b0b0b" fontsize="9">&lt;[federated.experiments].[usr:Effect txt:nk]&gt;</run>
                <run fontcolor="#898781" fontsize="9">  ·  </run>
                <run fontcolor="#898781" fontsize="9">&lt;[federated.experiments].[usr:p txt:nk]&gt;</run>
                <run fontcolor="#898781" fontsize="9">  ·  </run>
                <run fontcolor="#d03b3b" fontsize="9">&lt;[federated.experiments].[usr:SRM txt:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>([federated.experiments].[none:experiment:nk] / [federated.experiments].[none:read:nk] / [federated.experiments].[none:decision:nk])</rows>
        <cols />
      </table>
    </worksheet>
    <worksheet name="Ratings US">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#0b0b0b" fontsize="11">US App Store: number of ratings (label = average rating)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="App Store ratings" name="federated.market_ratings" />
          </datasources>
          <datasource-dependencies datasource="federated.market_ratings">
            <column caption="Focus app" datatype="string" name="[Focus app]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [focus] THEN &quot;Hily / Taimi&quot; ELSE &quot;Peer apps&quot; END" />
            </column>
            <column caption="US storefront" datatype="boolean" name="[US storefront]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[country] = &quot;us&quot;" />
            </column>
            <column caption="App" datatype="string" name="[app]" role="dimension" type="nominal" />
            <column caption="Average rating" datatype="real" name="[avg_rating]" role="measure" type="quantitative" />
            <column datatype="string" name="[country]" role="dimension" type="nominal" />
            <column datatype="boolean" name="[focus]" role="dimension" type="nominal" />
            <column caption="Number of ratings" datatype="integer" name="[rating_count]" role="measure" type="quantitative" />
            <column-instance column="[avg_rating]" derivation="Avg" name="[avg:avg_rating:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Focus app]" derivation="None" name="[none:Focus app:nk]" pivot="key" type="nominal" />
            <column-instance column="[US storefront]" derivation="None" name="[none:US storefront:nk]" pivot="key" type="nominal" />
            <column-instance column="[app]" derivation="None" name="[none:app:nk]" pivot="key" type="nominal" />
            <column-instance column="[rating_count]" derivation="Sum" name="[sum:rating_count:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.market_ratings].[none:US storefront:nk]">
            <groupfilter function="member" level="[none:US storefront:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <sort class="computed" column="[federated.market_ratings].[none:app:nk]" direction="DESC" using="[federated.market_ratings].[sum:rating_count:qk]" />
          <slices>
            <column>[federated.market_ratings].[none:US storefront:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="cell">
            <format attr="text-format" field="[federated.market_ratings].[avg:avg_rating:qk]" value="n0.00" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[federated.market_ratings].[none:Focus app:nk]" />
              <text column="[federated.market_ratings].[avg:avg_rating:qk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run fontcolor="#0b0b0b" fontsize="8">&lt;[federated.market_ratings].[avg:avg_rating:qk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.market_ratings].[none:app:nk]</rows>
        <cols>[federated.market_ratings].[sum:rating_count:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Prices">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#0b0b0b" fontsize="11">Hily 1-week Premium and Taimi Gold, price in USD by storefront (GB, DE, FR include VAT)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Subscription prices" name="federated.market_prices" />
          </datasources>
          <datasource-dependencies datasource="federated.market_prices">
            <column caption="App" datatype="string" name="[app]" role="dimension" type="nominal" />
            <column caption="Storefront" datatype="string" name="[country]" role="dimension" type="nominal" />
            <column caption="Price (USD)" datatype="real" name="[price_usd]" role="measure" type="quantitative" />
            <column-instance column="[app]" derivation="None" name="[none:app:nk]" pivot="key" type="nominal" />
            <column-instance column="[country]" derivation="None" name="[none:country:nk]" pivot="key" type="nominal" />
            <column-instance column="[price_usd]" derivation="Sum" name="[sum:price_usd:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="cell">
            <format attr="text-format" field="[federated.market_prices].[sum:price_usd:qk]" value="c&quot;$&quot;#,##0.00" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <color column="[federated.market_prices].[none:app:nk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.market_prices].[sum:price_usd:qk]</rows>
        <cols>([federated.market_prices].[none:country:nk] / [federated.market_prices].[none:app:nk])</cols>
      </table>
    </worksheet>
    <worksheet name="Review themes">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#0b0b0b" fontsize="11">Themes in written reviews, last 12 months (share of reviews; darker = more frequent)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Review themes" name="federated.review_themes" />
          </datasources>
          <datasource-dependencies datasource="federated.review_themes">
            <column caption="App group" datatype="string" name="[App group]" role="dimension" type="nominal">
              <calculation class="tableau" formula="IF [app] = &quot;Hily&quot; OR [app] = &quot;Taimi&quot; THEN [app] ELSE &quot;Peers (Tinder, Bumble, Hinge)&quot; END" />
            </column>
            <column caption="Theme share" datatype="real" default-format="p0%" name="[Theme share]" role="measure" type="quantitative">
              <calculation class="tableau" formula="AVG([share])" />
            </column>
            <column caption="App" datatype="string" name="[app]" role="dimension" type="nominal" />
            <column caption="Share of reviews" datatype="real" name="[share]" role="measure" type="quantitative" />
            <column caption="Theme" datatype="string" name="[theme]" role="dimension" type="nominal" />
            <column-instance column="[App group]" derivation="None" name="[none:App group:nk]" pivot="key" type="nominal" />
            <column-instance column="[theme]" derivation="None" name="[none:theme:nk]" pivot="key" type="nominal" />
            <column-instance column="[Theme share]" derivation="User" name="[usr:Theme share:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <sort class="computed" column="[federated.review_themes].[none:theme:nk]" direction="DESC" using="[federated.review_themes].[usr:Theme share:qk]" />
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Square" />
            <encodings>
              <color column="[federated.review_themes].[usr:Theme share:qk]" />
              <text column="[federated.review_themes].[usr:Theme share:qk]" />
            </encodings>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[federated.review_themes].[none:theme:nk]</rows>
        <cols>[federated.review_themes].[none:App group:nk]</cols>
      </table>
    </worksheet>
    <worksheet name="Trends">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#0b0b0b" fontsize="11">Google Trends, US, weekly (0-100 within one request; names are also first names)</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Google Trends US" name="federated.trends" />
          </datasources>
          <datasource-dependencies datasource="federated.trends">
            <column caption="Focus term" datatype="boolean" name="[Focus term]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[term] = &quot;Hily&quot; OR [term] = &quot;Taimi&quot; OR [term] = &quot;HER app&quot;" />
            </column>
            <column caption="Week" datatype="date" name="[date]" role="dimension" type="ordinal" />
            <column caption="Interest (0-100)" datatype="integer" name="[interest]" role="measure" type="quantitative" />
            <column caption="Search term" datatype="string" name="[term]" role="dimension" type="nominal" />
            <column-instance column="[Focus term]" derivation="None" name="[none:Focus term:nk]" pivot="key" type="nominal" />
            <column-instance column="[term]" derivation="None" name="[none:term:nk]" pivot="key" type="nominal" />
            <column-instance column="[interest]" derivation="Sum" name="[sum:interest:qk]" pivot="key" type="quantitative" />
            <column-instance column="[date]" derivation="Week-Trunc" name="[twk:date:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <filter class="categorical" column="[federated.trends].[none:Focus term:nk]">
            <groupfilter function="member" level="[none:Focus term:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <slices>
            <column>[federated.trends].[none:Focus term:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="axis">
            <format attr="title" class="0" field="[federated.trends].[twk:date:qk]" scope="cols" value=" " />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <color column="[federated.trends].[none:term:nk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.trends].[sum:interest:qk]</rows>
        <cols>[federated.trends].[twk:date:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
