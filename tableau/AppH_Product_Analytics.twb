  <worksheets>
    <worksheet name="KPI Sign-ups">
      <table>
        <view>
          <datasources>
            <datasource caption="Product pulse (daily)" name="federated.pulse" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="federated.pulse">
            <column caption="In scope" datatype="boolean" name="[In scope]" role="dimension" type="nominal">
              <calculation class="tableau" formula="([Parameters].[Country] = &quot;All&quot; OR [country] = [Parameters].[Country]) AND ([Parameters].[Platform] = &quot;All&quot; OR [platform] = [Parameters].[Platform])" />
            </column>
            <column caption="KPI sign-ups" datatype="string" name="[KPI sign-ups]" role="measure" type="nominal">
              <calculation class="tableau" formula="STR(ROUND(SUM([signups]) / 1000, 1)) + &quot;K&quot;" />
            </column>
            <column caption="Country" datatype="string" name="[country]" role="dimension" type="nominal" />
            <column caption="Platform" datatype="string" name="[platform]" role="dimension" type="nominal" />
            <column caption="Sign-ups" datatype="integer" name="[signups]" role="measure" type="quantitative" />
            <column-instance column="[In scope]" derivation="None" name="[none:In scope:nk]" pivot="key" type="nominal" />
            <column-instance column="[KPI sign-ups]" derivation="User" name="[usr:KPI sign-ups:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Country" datatype="string" name="[Country]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
              <calculation class="tableau" formula="&quot;All&quot;" />
              <members>
                <member value="&quot;All&quot;" />
                <member value="&quot;US&quot;" />
                <member value="&quot;GB&quot;" />
                <member value="&quot;CA&quot;" />
                <member value="&quot;AU&quot;" />
              </members>
            </column>
            <column caption="Platform" datatype="string" name="[Platform]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
              <calculation class="tableau" formula="&quot;All&quot;" />
              <members>
                <member value="&quot;All&quot;" />
                <member value="&quot;ios&quot;" />
                <member value="&quot;android&quot;" />
              </members>
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[federated.pulse].[none:In scope:nk]">
            <groupfilter function="member" level="[none:In scope:nk]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <slices>
            <column>[federated.pulse].[none:In scope:nk]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[federated.pulse].[usr:KPI sign-ups:nk]" />
            </encodings>
            <customized-label>
              <formatted-text>
                <run bold="true" fontcolor="#898781" fontsize="9">SIGN-UPS</run>
                <run>Æ
</run>
                <run bold="true" fontcolor="#0b0b0b" fontsize="20">&lt;[federated.pulse].[usr:KPI sign-ups:nk]&gt;</run>
              </formatted-text>
            </customized-label>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
