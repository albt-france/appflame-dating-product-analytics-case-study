            <column-instance column="[date]" derivation="Week-Trunc" name="[twk:date:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Avg DAU]" derivation="User" name="[usr:Avg DAU:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Avg daily sign-ups]" derivation="User" name="[usr:Avg daily sign-ups:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Country" datatype="string" name="[Country]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
              <calculation class="tableau" formula="&quot;All&quot;" />
              <members>
                <member value="&quot;All&quot;" />
                <member value="&quot;US&quot;" />
                <member value="&quot;GB&quot;" />
                <member value="&quot;CA&quot;" />
                <member value="&quot;AU&quot;" />
              </members>
            </column>
            <column caption="Platform" datatype="string" name="[Platform]" param-domain-type="list" role="measure" type="nominal" value="&quot;All&quot;">
