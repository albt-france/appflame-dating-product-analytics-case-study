      <column caption="Experiment" datatype="string" name="[experiment]" role="dimension" type="nominal" />
      <column caption="Read" datatype="string" name="[read]" role="dimension" type="nominal" />
      <column caption="CI width" datatype="real" default-format="p0.0%" name="[CI width]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([ci_high]) - SUM([ci_low])" />
      </column>
      <column caption="Verdict" datatype="string" name="[Verdict]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF CONTAINS([read], &quot;biased&quot;) OR CONTAINS([read], &quot;SRM&quot;) OR CONTAINS([read], &quot;misleading&quot;) THEN &quot;Misleading read&quot; ELSEIF [ci_low] &gt; 0 OR [ci_high] &lt; 0 THEN &quot;Effect (CI excludes 0)&quot; ELSE &quot;No clear effect&quot; END" />
      </column>
      <column caption="Effect txt" datatype="string" name="[Effect txt]" role="measure" type="nominal">
        <calculation class="tableau" formula="STR(ROUND(SUM([estimate]) * 100, 1)) + &quot;%  [&quot; + STR(ROUND(SUM([ci_low]) * 100, 1)) + &quot;, &quot; + STR(ROUND(SUM([ci_high]) * 100, 1)) + &quot;]&quot;" />
      </column>
      <column caption="p txt" datatype="string" name="[p txt]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF ISNULL(SUM([p_value])) THEN &quot;&quot; ELSEIF SUM([p_value]) &lt; 0.001 THEN &quot;p &lt; 0.001&quot; ELSE &quot;p = &quot; + STR(ROUND(SUM([p_value]), 3)) END" />
      </column>
      <column caption="SRM txt" datatype="string" name="[SRM txt]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF ISNULL(SUM([srm_p])) THEN &quot;&quot; ELSEIF SUM([srm_p]) &lt; 0.001 THEN &quot;SRM! p &lt; 0.001&quot; ELSE &quot;SRM ok&quot; END" />
      </column>
      <column caption="Test" datatype="string" name="[Test]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[experiment] + &quot;  ·  &quot; + [read]" />
      </column>
      <column-instance column="[Verdict]" derivation="None" name="[none:Verdict:nk]" pivot="key" type="nominal" />
