    <worksheet name="Sign-ups and DAU">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#0b0b0b" fontsize="11">Daily active users (bars) and daily sign-ups (line), weekly averages</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Product pulse (daily)" name="federated.pulse" />
