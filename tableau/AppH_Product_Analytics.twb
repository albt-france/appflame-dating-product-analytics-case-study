    <datasource caption="Product pulse (daily)" inline="true" name="federated.pulse" version="18.1">
      <connection class="federated">
        <named-connections>
          <named-connection caption="pulse" name="textscan.pulse">
            <connection class="textscan" directory="Data/Extracts" filename="pulse.csv" password="" server="" />
          </named-connection>
        </named-connections>
        <relation connection="textscan.pulse" name="pulse.csv" table="[pulse#csv]" type="table">
          <columns character-set="UTF-8" header="yes" locale="en_US" separator=",">
