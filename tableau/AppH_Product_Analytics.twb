        <zone h="8594" id="33" type-v2="text" w="88726" x="1171" y="1042">
          <formatted-text>
            <run bold="true" fontcolor="#0b0b0b" fontsize="15">Market view: Hily and Taimi rate 4.4★ like the leaders; price and fake-profile complaints stand out</run>
            <run>Æ
</run>
            <run fontcolor="#898781" fontsize="10">Public App Store, price and search data for Hily, Taimi and peer dating apps.</run>
          </formatted-text>
