      <aliases enabled="yes" />
      <column caption="Day" datatype="date" name="[date]" role="dimension" type="ordinal" />
      <column caption="Country" datatype="string" name="[country]" role="dimension" type="nominal" />
      <column caption="Platform" datatype="string" name="[platform]" role="dimension" type="nominal" />
      <column caption="Sign-ups" datatype="integer" name="[signups]" role="measure" type="quantitative" />
      <column caption="Daily active users" datatype="integer" name="[dau]" role="measure" type="quantitative" />
      <column caption="Matches" datatype="real" name="[matches]" role="measure" type="quantitative" />
      <column caption="New payers" datatype="integer" name="[new_payers]" role="measure" type="quantitative" />
      <column caption="Revenue (USD)" datatype="real" name="[revenue_usd]" role="measure" type="quantitative" />
      <column caption="In scope" datatype="boolean" name="[In scope]" role="dimension" type="nominal">
        <calculation class="tableau" formula="([Parameters].[Country] = &quot;All&quot; OR [country] = [Parameters].[Country]) AND ([Parameters].[Platform] = &quot;All&quot; OR [platform] = [Parameters].[Platform])" />
      </column>
      <column caption="Activation rate" datatype="real" default-format="p0.0%" name="[Activation rate]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([activated]) / SUM([signups])" />
      </column>
      <column caption="KPI sign-ups" datatype="string" name="[KPI sign-ups]" role="measure" type="nominal">
        <calculation class="tableau" formula="STR(ROUND(SUM([signups]) / 1000, 1)) + &quot;K&quot;" />
      </column>
      <column caption="KPI activation" datatype="string" name="[KPI activation]" role="measure" type="nominal">
        <calculation class="tableau" formula="STR(ROUND(SUM([activated]) / SUM([signups]) * 100, 1)) + &quot;%&quot;" />
      </column>
      <column caption="KPI matches" datatype="string" name="[KPI matches]" role="measure" type="nominal">
        <calculation class="tableau" formula="STR(ROUND(SUM([matches]) / 1000000, 2)) + &quot;M&quot;" />
      </column>
      <column caption="KPI payers" datatype="string" name="[KPI payers]" role="measure" type="nominal">
        <calculation class="tableau" formula="STR(ROUND(SUM([new_payers]) / SUM([signups]) * 100, 1)) + &quot;% of sign-ups&quot;" />
      </column>
      <column caption="KPI revenue" datatype="string" name="[KPI revenue]" role="measure" type="nominal">
        <calculation class="tableau" formula="&quot;$&quot; + STR(ROUND(SUM([revenue_usd]) / 1000, 0)) + &quot;K&quot;" />
      </column>
      <column caption="Avg daily sign-ups" datatype="real" default-format="n#,##0" name="[Avg daily sign-ups]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([signups]) / COUNTD([date])" />
      </column>
      <column caption="Avg DAU" datatype="real" default-format="n#,##0" name="[Avg DAU]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([dau]) / COUNTD([date])" />
      </column>
      <column caption="Full weeks" datatype="boolean" name="[Full weeks]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[date] &lt; #2026-10-25#" />
      </column>
      <column-instance column="[platform]" derivation="None" name="[none:platform:nk]" pivot="key" type="nominal" />
